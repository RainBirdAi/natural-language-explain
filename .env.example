# --- Google Cloud / Vertex AI ------------------------------------------------
# Gemini is called through Vertex AI and authenticated with GCP roles via
# Application Default Credentials (ADC) -- there is no API key.
#
# Local dev:  gcloud auth application-default login
# Deployment: attach a service account whose principal has the
#             "Vertex AI User" (roles/aiplatform.user) role on the project.
GCP_PROJECT_ID=your-gcp-project-id
# Location can depend on the model. Gemini 3.x models are typically served from
# the "global" endpoint; regional models use e.g. "us-central1" / "europe-west1".
GCP_LOCATION=global

# --- Gemini model + generation ----------------------------------------------
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2

# --- Prompt ------------------------------------------------------------------
# Path to the base prompt template (relative to the process working directory).
PROMPT_PATH=prompt.txt

# --- Rainbird ----------------------------------------------------------------
# Base URL of the Rainbird API (the evidence path is appended by the app).
RAINBIRD_API_URL=https://api.rainbird.ai
# HTTP timeout, in seconds, for the evidence request.
RAINBIRD_TIMEOUT_SECONDS=30
